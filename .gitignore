# —— CPW-Pro / CapsWriter：勿提交个人隐私、运行时垃圾与巨型二进制 ——

# LLM/API 与用户路径（必须由每人本地生成，见仓库内 config.example.json）
config.json
cpw_config.json

# 本地 IDE / 助手（勿提交）
.claude/
.cursor/
.mcps/

# 常见密钥载体
.env
.env.*
*.pem
**/secrets.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
myenv/
pip-log.txt
*.egg-info/
.eggs/
dist/
build/
*.egg

# IDE / OS
.idea/
*.swp
Thumbs.db
Desktop.ini

# 运行日志与产出（体积大、涉隐私）
logs/
*.log
output/

# Jupyter / pytest
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/

# —— GitHub：模型权重与本机二进制（体积过大，按官方 Release 自备）——
# ASR/GGUF/ONNX 权重（models 下仍可保留 ipynb、py、说明 txt、演示音频等小文件）
models/**/*.gguf
models/**/*.onnx

# 上游打包内嵌 Python 运行时（通常 >200MB）
internal/

# 官方预编译入口（从 HaujetZhao/CapsWriter-Offline Releases 下载）
start_client.exe
start_server.exe

# llama.cpp / Vulkan 等原生库（随上游或自行放入 util/llama/bin，不进版本库）
util/llama/bin/*.dll
util/llama/bin/*.exe
